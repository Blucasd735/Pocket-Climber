{
  "schema": 1,
  "id": "gmloader-runtime",
  "version": "1.0.0",
  "title": "PREPARANDO JOGO",
  "abi_order": [
    "arm64-v8a"
  ],
  "input": {
    "search_dirs": [
      "gamedata"
    ],
    "prefer_first_nonempty": true,
    "sniff_all_in_primary": true,
    "extensions": [
      ".apk",
      ".xapk",
      ".apkm",
      ".apks",
      ".zip"
    ],
    "max_files": 128,
    "max_bundle_apks": 128,
    "max_member_bytes": 2147483648,
    "max_bundle_bytes": 6442450944
  },
  "extract": [
    {
      "id": "apk-bootstrap",
      "source": {
        "kind": "entry",
        "patterns": [
          "assets/game.droid"
        ],
        "scopes": [
          "apk"
        ]
      },
      "destination": "gamedata/runtime.apk",
      "validate": {
        "min_size": 1
      }
    }
  ],
  "hooks": [
    {
      "id": "build-gmloader-runtime",
      "argv": [
        "python3",
        "{game_dir}/tools/prepare_gmloader_runtime.py",
        "--game-dir",
        "{game_dir}",
        "--stage",
        "{stage}",
        "--abi",
        "{abi}"
      ],
      "cwd": "{game_dir}",
      "checkpoint": [
        {
          "path": "gamedata/runtime.apk",
          "type": "file",
          "min_size": 1,
          "magic_ascii": "PK"
        }
      ]
    }
  ],
  "validate": [
    {
      "path": "gamedata/runtime.apk",
      "type": "file",
      "min_size": 1,
      "magic_ascii": "PK"
    }
  ],
  "commit": [
    "gamedata/runtime.apk"
  ],
  "marker": ".nxextract-gmloader-runtime.json",
  "space": {
    "safety_bytes": 134217728
  },
  "log": "nxextract.log",
  "ui_success_seconds": 1,
  "ui_error_seconds": 8
}
